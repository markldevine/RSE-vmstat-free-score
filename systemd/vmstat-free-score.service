[Unit]
Description=RSE Freedom Score Daemon (Rust)
After=network-online.target valkey.service
Wants=network-online.target

[Service]
# The binary location (adjust if you put it elsewhere)
ExecStart=/var/lib/data/scripts/vmstat-free-score

# Restart automatically if it crashes or is killed
Restart=always
RestartSec=3

# Simple output logging (goes to journald)
StandardOutput=journal
StandardError=journal

# Run as root to ensure rebootmgrctl access (or use a user with permissions)
User=root
Group=root

# Hardening (Optional but recommended for MicroOS)
ProtectSystem=full
ProtectHome=yes

[Install]
WantedBy=multi-user.target
